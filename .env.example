# ─────────────────────────────────────────────────────────────────────────────
# CATROT website — deployment configuration
#
# Copy to .env.local for local development, and set the same keys in the Vercel
# project settings for preview and production.
#
# None of these are secrets. Everything here appears on the rendered page.
# Never put an API key, token or private credential in this file — the site has
# no server-side logic that would need one.
#
# A production build FAILS while any value below is missing or still holds its
# REPLACE_WITH_… placeholder. See README.md.
# ─────────────────────────────────────────────────────────────────────────────

# Full App Store listing URL for the CATROT iOS app.
# Example: https://apps.apple.com/app/catrot/id1234567890
NEXT_PUBLIC_APP_STORE_URL=REPLACE_WITH_APP_STORE_URL

# The registered legal entity that publishes CATROT, exactly as registered.
# Shown in the footer copyright, the Privacy Policy and the Terms.
LEGAL_COMPANY_NAME=REPLACE_WITH_LEGAL_ENTITY

# Postal address of that entity, on one line.
BUSINESS_ADDRESS=REPLACE_WITH_BUSINESS_ADDRESS

# Canonical origin of this site, no trailing slash.
# Used for canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
WEBSITE_URL=https://REPLACE_WITH_DOMAIN.com

# Support and privacy contact. Defaults to catrotsupp@gmail.com if unset.
SUPPORT_EMAIL=catrotsupp@gmail.com

# Jurisdiction whose law governs the Terms, phrased to read naturally in the
# sentence "These terms are governed by ___".
# Example: the laws of France
LEGAL_GOVERNING_LAW=REPLACE_WITH_GOVERNING_LAW
